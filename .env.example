# ---------------------------------------------------------------------------
# iCook — пример переменных окружения.
# Скопируйте этот файл в `.env` и при необходимости поменяйте значения:
#   cp .env.example .env      (Linux/macOS/Git Bash)
#   copy .env.example .env    (Windows CMD)
# `.env` НЕ коммитится в Git.
# ---------------------------------------------------------------------------

# Режим приложения: development | production
APP_ENV=development

# --- Порты на хосте ---------------------------------------------------------
WEB_PORT=8080
DB_HOST_PORT=3307
PMA_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- MySQL ------------------------------------------------------------------
DB_NAME=icook_db
DB_USER=icook
DB_PASSWORD=icook_secret
DB_ROOT_PASSWORD=icook_root_secret

# --- phpMyAdmin -------------------------------------------------------------
PMA_UPLOAD_LIMIT=64M
