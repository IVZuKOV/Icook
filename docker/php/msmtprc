# ---------------------------------------------------------------------------
# msmtp -> Mailpit
# PHP mail() перехватывается и складывается в Mailpit (http://localhost:8025).
# Наружу письма НЕ уходят — это удобно и безопасно для разработки.
# ---------------------------------------------------------------------------
defaults
auth           off
tls            off
logfile        -

account        default
host           mailpit
port           1025
from           noreply@icook.local
